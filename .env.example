# Copy to .env and fill in. Never commit .env.

# Runs allowed per day across everyone. Empty means 200.
DEMO_DAILY_LIMIT=

# Model provider. Any OpenAI-compatible endpoint.
PROVIDER_BASE_URL=https://api.oxlo.ai/v1
PROVIDER_API_KEY=

# One model per language, as one JSON object. Must be valid JSON with all three
# languages: an empty value stops the app at startup.
MODELS={"en": "qwen-3-32b", "ar": "qwen-3-32b", "fr": "qwen-3-32b"}
